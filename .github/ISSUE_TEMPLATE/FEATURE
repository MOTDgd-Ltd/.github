name: Feature
description: A feature to be added
labels: ["feature", "triage"]
projects: ["MOTDgd-Ltd/1"]
assignees:
  - octocat
body:
  - type: textarea
    id: description
    attributes:
      label: Description
      description: Describe the feature that needs to be added
    validations:
      required: true
  - type: textarea
    id: acceptance-criteria
    attributes:
      label: Acceptance criteria
      description: What constitutes as done
    validations:
      required: true
  - type: textarea
    id: notes
    attributes:
      label: Notes
      description: Any additional notes to help whoever picks this up
    validations:
      required: false
